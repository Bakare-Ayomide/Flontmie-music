# Apache / LiteSpeed configuration for Flontmie PHP Backend
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pass Authorization Header to PHP environment
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Protect config.php from direct HTTP reading
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Ensure PHP error display is off and upload limits are appropriate
<IfModule mod_php.c>
    php_flag display_errors Off
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
